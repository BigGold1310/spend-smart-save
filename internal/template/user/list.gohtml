{{template "layout/base.gohtml" .}}
{{ define "content" }}
    <div class="bg-white shadow rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Username</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
            {{range .Users}}
                <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{.ID}}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{.Username}}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{.Email}}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{.CreatedAt.Format "2006-01-02"}}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                        <a href="/users/{{.ID}}" class="text-indigo-600 hover:text-indigo-900">View</a>
                    </td>
                </tr>
            {{end}}
            </tbody>
        </table>
    </div>
{{ end }}